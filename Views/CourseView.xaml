<UserControl x:Class="X_menu_app.Views.CourseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:X_menu_app.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.DataContext>
        <vm:CourseViewModel />
    </UserControl.DataContext>

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Barre d'outils haut -->
            <RowDefinition Height="*"/>
            <!-- Grille 3x3 des produits -->
            <RowDefinition Height="Auto"/>
            <!-- Pied de page Total -->
        </Grid.RowDefinitions>

        <!-- 1. BARRE SUPERIEURE -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Menu Trier -->
            <ComboBox Grid.Column="0" SelectedValuePath="Tag" SelectedValue="{Binding SelectedSortMode, Mode=TwoWay}" Width="220" Margin="0,0,10,0">
                <ComboBoxItem Content="Nom (A-Z)" Tag="name_asc" />
                <ComboBoxItem Content="Prix (Croissant)" Tag="price_asc" />
                <ComboBoxItem Content="Prix (Décroissant)" Tag="price_desc" />
                <ComboBoxItem Content="Etat : Disponible d'abord" Tag="available" />
                <ComboBoxItem Content="Etat : Non-disponible d'abord" Tag="unavailable" />
            </ComboBox>
            <!-- Affiche l'option active (masquée) -->
            <!-- TextBlock de label de tri supprimé / masqué par demande utilisateur -->

            <!-- Bouton Tout De/sélectionner (toggle) -->
            <Button Grid.Column="1" Content="{Binding ToggleSelectAllLabel}" Command="{Binding ToggleSelectAllCommand}"
                    Margin="0,0,15,0" Padding="15,8" Background="#FFFFFF" BorderBrush="#CCCCCC" FontWeight="SemiBold"/>

            <!-- Barre de Recherche -->
            <Border Grid.Column="2" CornerRadius="18" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,15,0">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="5,0,8,0" Foreground="Gray"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="14"/>
                </Grid>
            </Border>

            <!-- Bouton Modifier -->
            <Button Grid.Column="3" Content="Modifier" Command="{Binding EditSelectedCommand}" IsEnabled="{Binding CanEdit}"
                    Background="#F1C40F" Foreground="{DynamicResource ModifierButtonForeground}" FontWeight="Bold" Padding="14,8" Margin="0,0,10,0" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Bouton Ajouter -->
            <Button Grid.Column="4" Content="+ Ajouter" Command="{Binding AddProductCommand}"
                    Background="#2ECC71" Foreground="White" FontWeight="Bold" Padding="18,8" Margin="0,0,10,0" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Bouton Supprimer -->
            <Button Grid.Column="5" Content="- Supprimer" Command="{Binding DeleteSelectedCommand}"
                    Background="#E74C3C" Foreground="White" FontWeight="Bold" Padding="18,8" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- 2. GRILLE DE PRESENTATION 3x3 (MAX 9 CARTES) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredProducts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="16" BorderBrush="#000000" BorderThickness="1.5" Margin="8" Height="190">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Case à cocher supérieure -->
                                    <RowDefinition Height="*"/>
                                    <!-- Contenu principal -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Zone Prix & Etat -->
                                </Grid.RowDefinitions>

                                <!-- Checkbox de sélection (Haut-Gauche) -->
                                <CheckBox Grid.Row="0" IsChecked="{Binding IsSelected}" HorizontalAlignment="Left" Margin="2,0,0,4"/>

                                <!-- Zone Principale (Image | Infos) -->
                                <Grid Grid.Row="1" Margin="0,2,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <!-- Colonne Image -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Barre verticale -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Infos Produit -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Image du produit -->
                                    <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Margin="0,0,5,0">
                                        <Image Source="{Binding ImagePath}" Stretch="UniformToFill" Width="100" Height="100"/>
                                    </Border>

                                    <!-- Barre verticale noire de séparation -->
                                    <Rectangle Grid.Column="1" Width="2" Fill="Black" Margin="2,0,8,0" VerticalAlignment="Stretch"/>

                                    <!-- Nom et Quantité -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Quantity, StringFormat='Quantité : {0}'}" Foreground="#555555" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Zone Inférieure (Prix | Etat) -->
                                <Grid Grid.Row="2" Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Encadré du Prix en EUROS (€) -->
                                    <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Padding="6,2" Background="#FAFAFA">
                                        <TextBlock Text="{Binding Price, StringFormat='prix : {0:C2}'}" FontWeight="Bold" FontSize="13"/>
                                    </Border>

                                    <!-- État de disponibilité -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Etat : " FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <CheckBox IsChecked="{Binding IsAvailable}" VerticalAlignment="Center">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="Content" Value="✔" />
                                                    <Setter Property="Foreground" Value="Green" />
                                                    <Setter Property="FontSize" Value="14" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter Property="Content" Value="✖" />
                                                            <Setter Property="Foreground" Value="Red" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 3. PIED DE PAGE : TOTAL EN EUROS (€) -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="🛒 " FontSize="18" VerticalAlignment="Center"/>
                <TextBlock Text="PRIX : " FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                <!-- Save indicator -->
                <TextBlock Text="{Binding SaveStatus}" Foreground="#27AE60" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />

                <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:N2} €'}" Foreground="#2ECC71" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
