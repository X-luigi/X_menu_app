<Window x:Class="X_menu_app.Views.AddTransactionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:X_menu_app.Converters"
    Title="Ajouter / Éditer une transaction" Height="500" Width="450" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,16">
                <!-- Date Section -->
                <Border Background="#F0F4F8" Padding="12" CornerRadius="6" Margin="0,0,0,16">
                    <StackPanel>
                        <Label Content="📅 Date" FontWeight="SemiBold" Padding="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DatePicker SelectedDate="{Binding Transaction.Date}" Grid.Column="0" Padding="8" />
                            <Button Content="Aujourd'hui" Grid.Column="1" Margin="8,0,0,0" Padding="12,6" Click="SetTodayDate" Background="#E8F0F8" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Label Section -->
                <Border Background="#F0F4F8" Padding="12" CornerRadius="6" Margin="0,0,0,16">
                    <StackPanel>
                        <Label Content="📝 Libellé (Description)" FontWeight="SemiBold" Padding="0,0,0,8" />
                        <TextBox Text="{Binding Transaction.Label, UpdateSourceTrigger=PropertyChanged}" Padding="8" MinHeight="32" />
                    </StackPanel>
                </Border>

                <!-- Amount Section -->
                <Border Background="#F0F4F8" Padding="12" CornerRadius="6" Margin="0,0,0,16">
                    <StackPanel>
                        <Label Content="💰 Montant" FontWeight="SemiBold" Padding="0,0,0,8" />

                        <!-- Type Selection: Dépôt/Retrait -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Dépôt (Green) -->
                            <Border Grid.Column="0" Background="#DFF0D8" BorderBrush="#5CB85C" BorderThickness="2" CornerRadius="4" Margin="0,0,8,0" Padding="8" x:Name="DepotBorder">
                                <StackPanel HorizontalAlignment="Center">
                                    <RadioButton Content="➕ Dépôt" GroupName="TransactionType" 
                                                 IsChecked="{Binding Transaction.IsExpense, Converter={StaticResource InverseBoolConverter}}" 
                                                 HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#5CB85C" />
                                    <TextBlock Text="(Argent entrant)" FontSize="11" HorizontalAlignment="Center" Foreground="#5CB85C" />
                                </StackPanel>
                            </Border>

                            <!-- Retrait (Red) -->
                            <Border Grid.Column="1" Background="#F2DEDE" BorderBrush="#D9534F" BorderThickness="2" CornerRadius="4" Margin="8,0,0,0" Padding="8" x:Name="RetraitBorder">
                                <StackPanel HorizontalAlignment="Center">
                                    <RadioButton Content="➖ Retrait" GroupName="TransactionType" 
                                                 IsChecked="{Binding Transaction.IsExpense}" 
                                                 HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#D9534F" />
                                    <TextBlock Text="(Argent sortant)" FontSize="11" HorizontalAlignment="Center" Foreground="#D9534F" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Amount Input -->
                        <TextBox Text="{Binding Transaction.Amount, UpdateSourceTrigger=PropertyChanged}" Padding="8" MinHeight="36" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="✔️ Valider" Width="100" Padding="8,6" Margin="8,0,0,0" Background="#DFF0D8" Click="Ok_Click" FontWeight="SemiBold" />
            <Button Content="❌ Annuler" Width="100" Padding="8,6" Margin="8,0,0,0" Background="#F2DEDE" Click="Cancel_Click" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>