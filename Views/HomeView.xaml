<UserControl x:Class="X_menu_app.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid Margin="30" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="BONJOUR " FontSize="28" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="{Binding UserName}" FontSize="28" FontWeight="Bold" Foreground="#3498DB"/>
                <TextBlock Text=" 😊" FontSize="28"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                <TextBlock Text="Nous sommes aujourd'hui le : " FontSize="14" Foreground="#7F8C8D"/>
                <TextBlock Text="{Binding TodayDate}" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50"/>
            </StackPanel>

            <Border Background="#F8F9FA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="JE SUIS X_MENU_APP, JE TE PERMETTRAI DE SUIVRE L'ENSEMBLE DE TES CHARGES ET DÉPENSES AINSI QU'UN BON PLANNING POUR TES COURSES ET POUR TON BUDGET."
                               TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" LineHeight="20"/>
                    <TextBlock Text="MERCI ET BON PROFIT À TOI :)" Margin="0,15,0,0" FontWeight="Bold" Foreground="#27AE60"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Rectangle Grid.Column="1" Width="2" Fill="#E2E8F0" Margin="10,20"/>

        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0">
            <Border CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="2" Margin="0,0,0,15">
                <Button Command="{Binding NavigateToWalletCommand}" Height="55" Background="White" BorderThickness="0">
                    <Grid Width="220">
                        <TextBlock Text="PORTEFEUILLE" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="👛" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Border>

            <Border CornerRadius="10" BorderBrush="#3498DB" BorderThickness="2" Margin="0,0,0,15">
                <Button Command="{Binding NavigateToCourseCommand}" Height="55" Background="White" BorderThickness="0">
                    <Grid Width="220">
                        <TextBlock Text="COURSE" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="🛒" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Border>

            <Border CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="2" Margin="0,0,0,30">
                <Button Height="55" Background="White" BorderThickness="0">
                    <Grid Width="220">
                        <TextBlock Text="PLANNING REPAS" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="📅" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Border>

            <Border CornerRadius="10" Background="#FFEBEE" BorderBrush="#E57373" BorderThickness="1">
                <Button Command="{Binding ExitCommand}" Height="45" Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="✖ " Foreground="#C62828" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="EXIT" Foreground="#C62828" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>