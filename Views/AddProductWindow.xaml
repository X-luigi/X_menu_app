<Window x:Class="X_menu_app.Views.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un produit" Height="380" Width="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Nom du produit:" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox" Grid.Column="1" Margin="12,0,0,0" Width="360"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Quantité:" VerticalAlignment="Center"/>
            <TextBox x:Name="QuantityBox" Grid.Column="1" Margin="12,0,0,0" Width="120"/>
            <TextBlock Text="Prix (€) :" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="24,0,0,0"/>
            <TextBox x:Name="PriceBox" Grid.Column="2" Margin="90,0,0,0" Width="120" HorizontalAlignment="Left"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox x:Name="AvailableBox" Content="Disponible" IsChecked="True" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Photo options -->
        <GroupBox Grid.Row="3" Header="Photo associée" Margin="0,8,0,0">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="NoPhotoRadio" Content="Pas de photo" IsChecked="True" Checked="PhotoOption_Checked"/>
                        <RadioButton x:Name="WithPhotoRadio" Content="Avec photo" Margin="12,0,0,0" Checked="PhotoOption_Checked"/>
                    </StackPanel>

                    <Button x:Name="BrowseButton" Content="Parcourir..." Width="120" Click="BrowseImage_Click" IsEnabled="False"/>
                    <TextBlock x:Name="ImagePathText" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" Width="280"/>
                </StackPanel>

                <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Width="160" Height="120" HorizontalAlignment="Right">
                    <Image x:Name="PreviewImage" Stretch="UniformToFill" />
                </Border>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="90" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Annuler" Width="90" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
