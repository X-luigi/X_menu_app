<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#121212" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4CAF50" />
    <!-- Ensure modifier button text is visible on dark theme (yellow background) -->
    <SolidColorBrush x:Key="ModifierButtonForeground" Color="#000000" />
</ResourceDictionary>