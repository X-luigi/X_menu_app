<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F9" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#334155" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#7F8C8D" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="White" />
    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="White" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2ECC71" />
    <!-- Modifier button specific foreground to ensure contrast on accent color -->
    <SolidColorBrush x:Key="ModifierButtonForeground" Color="#000000" />
</ResourceDictionary>